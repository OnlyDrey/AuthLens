{
  "scenario": "B14-approval",
  "context": "elevated",
  "description": "Missing -Yes refuses every approval-gated action before anything runs. Runs ELEVATED so the elevation gate cannot be the reason. Inputs are chosen to fail safely if the approval gate were missing (nonexistent backup/release/ACL inventory); the asserted refusal reason identifies the approval gate, so an unrelated refusal does not pass.",
  "cases": [
    {
      "id": "Deploy-noYes",
      "args": [
        "-Action",
        "Deploy",
        "-Release",
        "{scratch}\nonexistent-release"
      ],
      "expect": {
        "exit": [
          2
        ],
        "reason": "changes the service or its permissions; repeat with -Yes",
        "forbidden_reason": "needs an elevated session",
        "state_unchanged": true
      }
    },
    {
      "id": "InstallService-noYes",
      "args": [
        "-Action",
        "InstallService"
      ],
      "expect": {
        "exit": [
          2
        ],
        "reason": "changes the service or its permissions; repeat with -Yes",
        "forbidden_reason": "needs an elevated session",
        "state_unchanged": true
      }
    },
    {
      "id": "Restore-noYes",
