{
  "scenario": "B13",
  "context": "any",
  "description": "Simulations leave the persistent installation state unchanged; unsupported -DryRun actions refuse before running. Recovery cases here cover the journal state of the installation under test only (a terminal journal does not cover interrupted-recovery simulation).",
  "cases": [
    {
      "id": "Deploy-DryRun",
      "args": [
        "-Action",
        "Deploy",
        "-Release",
        "{release}",
        "-DryRun"
      ],
      "expect": {
        "exit": [
          0
        ],
        "reason": "SIMULATION \\(-DryRun\\): no change was made",
        "simulation": true,
        "changes_applied": false,
        "state_unchanged": true
      }
    },
    {
      "id": "Deploy-DryRun-Yes",
      "args": [
        "-Action",
        "Deploy",
        "-Release",
        "{release}",
        "-DryRun",
        "-Yes"
      ],
      "expect": {
        "exit": [
          0
        ],
        "reason": "SIMULATION \\(-DryRun\\): no change was made",
        "simulation": true,
        "changes_applied": false,
        "state_unchanged": true
      }
    },
    {
      "id": "Recover-DryRun",
      "args": [
        "-Action",
        "Recover",
        "-DryRun"
      ],
      "expect": {
        "exit": [
          0,
          2
        ],
        "reason": "SIMULATION \\(-DryRun\\): no change was made",
        "simulation": true,
        "changes_applied": false,
        "state_unchanged": true
      }
    },
    {
      "id": "Recover-DryRun-Yes",
      "args": [
        "-Action",
